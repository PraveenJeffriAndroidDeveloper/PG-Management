<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="150dp"
    android:layout_height="220dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="10dp"
    android:layout_margin="16dp"
    android:background="@color/white"
    app:cardElevation="20dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <TextView
            android:id="@+id/roomNumtextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room No : 01"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/roomChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/roomNumtextView"
            app:singleLine="false"
            android:layoutDirection="ltr"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginTop="10dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/acChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AC"
                android:textColor="@color/white"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/sharingChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 Sharing"
                android:textColor="@color/white"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/isFullchip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fully Occupied"
                android:textColor="@color/white"/>
        </com.google.android.material.chip.ChipGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>